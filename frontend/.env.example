# URL da API (Azure App Service). Em desenvolvimento deixe vazio: o Vite faz proxy de /api para localhost:8080.
VITE_API_URL=

# Firebase Cloud Messaging (opcional). Sem estas variáveis, os avisos aparecem só dentro do app (polling a cada 15 s).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
